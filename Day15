class Solution:
    def mergeTwoLists(self, list1, list2):
        a = []

        while list1:
            a.append(list1.val)
            list1 = list1.next

        while list2:
            a.append(list2.val)
            list2 = list2.next

        a.sort()

        dummy = ListNode(0)
        temp = dummy

        for i in a:
            temp.next = ListNode(i)
            temp = temp.next

        return dummy.next